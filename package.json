{
  "name": "github-cards",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.3.3",
    "lucide-react": "latest",
    "next": "^16.4.5",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "19.3.1",
    "vinext": "^1.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.12",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "1.0.0-beta.28",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "8.3.0"
  },
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
