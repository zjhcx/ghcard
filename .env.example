# Optional: higher REST API limits and official GraphQL contribution calendar.
# Without a token, heatmaps use the public contribution API.
# Server only; never use NEXT_PUBLIC_.
GITHUB_TOKEN=

# Optional HTTPS proxy prefix for public GitHub REST API requests.
# Example: https://proxy.example/ -> https://proxy.example/https://api.github.com/users/octocat
# GITHUB_TOKEN is never sent to this proxy. Leave empty for direct requests.
GHPROXY=
